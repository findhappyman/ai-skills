# Copy to a private location outside this skill; never commit filled credentials.
# Load using your shell, or pass explicit command arguments.
ARTICLE_WORKSPACE=
RECORDINGS_ROOT=
# Set only channels you intend to authorize; empty means generate review files.
DEFAULT_CHANNELS=
AUTHOR_VISUAL_PROFILE=
ARTICLE_SITE_ROOT=
ARTICLE_SITE_AUTHOR=""
ARTICLE_SITE_REMOTE=origin
ARTICLE_SITE_BRANCH=main
ARTICLE_SITE_BLOG_DIR=src/content/blog
ARTICLE_SITE_COVERS_DIR=public/covers
ARTICLE_SITE_IMAGES_DIR=public/article-images
ARTICLE_SITE_NPM=npm
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_AUTHOR=""
# Optional HTTP/HTTPS fixed egress proxy when required by your WeChat setup.
WECHAT_HTTPS_PROXY=
# Optional browser profile for the host's browser tool; no profile is shipped.
X_ARTICLE_CHROME_PROFILE=
